{
  "name": "motion-training-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MOTION — 个人训练工作区（离线优先的本地训练记录 Web App）",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "serve:v2": "node scripts/serve.mjs --dist dist-v2 --port 5299",
    "build:v1": "MOTION_OUT_DIR=dist npm run build",
    "serve:v1": "node scripts/serve.mjs --dist dist --port 5199",
    "serve:v3": "node scripts/serve.mjs --dist dist-v3 --port 5399",
    "build:v4": "MOTION_OUT_DIR=dist-v4 npm run build",
    "serve:v4": "node scripts/serve.mjs --dist dist-v4 --port 5499",
    "build:v5": "MOTION_OUT_DIR=dist-v5 npm run build",
    "serve:v5": "node scripts/serve.mjs --dist dist-v5 --port 5599",
    "build:v6": "MOTION_OUT_DIR=dist-v6 npm run build",
    "serve:v6": "node scripts/serve.mjs --dist dist-v6 --port 5699",
    "build:v7": "MOTION_OUT_DIR=dist-v7 npm run build",
    "serve:v7": "node scripts/serve.mjs --dist dist-v7 --port 5799",
    "build:v8": "MOTION_OUT_DIR=dist-v8 npm run build",
    "serve:v8": "node scripts/serve.mjs --dist dist-v8 --port 5899",
    "build:android": "MOTION_TARGET=android MOTION_OUT_DIR=dist-android vite build",
    "android:sync": "npx cap sync android",
    "android:apk": "node scripts/build-android.mjs",
    "android:apk:release": "node scripts/build-android.mjs --release",
    "android:test:java": "node scripts/test-native.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/status-bar": "8.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.6",
    "puppeteer-core": "^23.11.1",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
